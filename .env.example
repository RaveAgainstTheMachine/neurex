# ─────────────────────────────────────────────────────────────────────────────
# Neurex — Environment Configuration
# Copy to .env and fill in values before running docker-compose up
# ─────────────────────────────────────────────────────────────────────────────

# Security — change these in any non-dev environment
API_TOKEN=neurex-dev-token
CHROMA_TOKEN=neurex-secret

# Workspace — absolute path to the project directory the IDE should open
WORKSPACE_PATH=./workspace

# Model overrides (if not set, auto-detected from VRAM at startup)
# DEFAULT_MODEL=qwen2.5-coder:14b
# EMBED_MODEL=nomic-embed-text

# Ollama tuning
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=2

# Performance models (used by ollama-entrypoint.sh tier selection)
PERF_MODEL=deepseek-r1:32b
BALANCED_MODEL=qwen2.5-coder:14b
LIGHT_MODEL=qwen2.5-coder:7b

# Logging
LOG_LEVEL=info

# Node env for Next.js build target (development | production)
NODE_ENV=development
