# Neurex Environment Configuration
# Copy this to .env and adjust as needed

# ── LLM / Agentic ──
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5-coder:14b
API_TOKEN=neurex-dev-token

# ── Storage & RAG ──
# Absolute path to where vector data is stored
CHROMA_DB_DIR=/home/user/.neurex/chroma_db
# Absolute path to the workspace the agents will operate on
WORKSPACE_PATH=/home/user/projects/neurex

# ── Sandbox ──
# Docker image for the execution sandbox
SANDBOX_IMAGE=neurex-sandbox:latest

# ── Logging ──
LOG_LEVEL=info

# ── Gitea CI/CD Integration ──
GITEA_BASE_URL=http://localhost:3000
GITEA_TOKEN=your_gitea_token_here
GITEA_OWNER=neurex
GITEA_REPO=neurex

